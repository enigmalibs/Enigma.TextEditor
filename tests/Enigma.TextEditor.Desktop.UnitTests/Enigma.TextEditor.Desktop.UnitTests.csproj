<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the single TFM of the project under test (Enigma.TextEditor.Desktop, net10.0). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Enigma.TextEditor.Desktop.UnitTests</RootNamespace>
    <!-- Headless Avalonia tests need the compiled-binding switch of the app under test. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- Avalonia.Headless supplies a windowing platform with no screen behind it; Avalonia.Skia
         renders its frames. Part of the version-coupled Avalonia set. -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.TextEditor.Desktop/Enigma.TextEditor.Desktop.csproj" />
  </ItemGroup>
</Project>
