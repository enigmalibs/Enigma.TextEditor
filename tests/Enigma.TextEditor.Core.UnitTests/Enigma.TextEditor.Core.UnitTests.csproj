<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the single TFM of the project under test (Enigma.TextEditor.Core, net10.0). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Enigma.TextEditor.Core.UnitTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.TextEditor.Core/Enigma.TextEditor.Core.csproj" />
  </ItemGroup>
  <!-- The template's fixture copy-glob is deliberately omitted: this suite builds every file it reads
       in a temporary folder at run time. -->
</Project>
