<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- TFM deviation from the house library default (netstandard2.0;net8.0;net10.0): this library is
         app-internal and never published as a NuGet package. It exists to keep the vim engine, the
         text-file layer and the layout model free of any Avalonia dependency, so it is consumed only
         by Enigma.TextEditor.Desktop and its tests, and targets the app's own TFM alone. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Enigma.TextEditor.Core</RootNamespace>
    <!-- The product version, shared with the Desktop app: this library ships only inside it, so the
         two move together. Distinct from the dependency pins in Directory.Packages.props. -->
    <Version>0.1.0</Version>
    <!-- GenerateDocumentationFile is deliberately absent: an app-internal library ships no XML doc
         file, and enabling it under TreatWarningsAsErrors would demand an XML comment on every public
         member (CS1591). -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Read/write JSON settings. Brings only Microsoft.Extensions.DependencyInjection.Abstractions. -->
    <PackageReference Include="Enigma.Configuration" />
  </ItemGroup>
  <!-- LangVersion / Nullable / ImplicitUsings / TreatWarningsAsErrors are deliberately absent: they
       come from Directory.Build.props. No Version attribute on a PackageReference either — versions
       live in Directory.Packages.props (CPM). -->
</Project>
