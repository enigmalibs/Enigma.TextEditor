<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Enigma.TextEditor.Desktop.Views"
             x:Class="Enigma.TextEditor.Desktop.App">

  <!-- FluentTheme must stay: Enigma.Avalonia.Desktop declares ControlThemes only for its own
       controls, so without it every framework control loses its template. -->
  <Application.Styles>
    <FluentTheme />
    <!-- AvaloniaEdit ships its control theme separately from the assembly's default styles: without
         this include the TextEditor renders as an untemplated blank. It has to come after
         FluentTheme, whose ScrollViewer/ScrollBar themes it builds on. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- A menu item with a Vim twin (views:VimHint.Keys): its header, then the Vim keys right-aligned
         in the header's stretched column, just before the shortcut column, in the shortcut's colour.
         Here rather than in a window, so menus and context menus everywhere get the same layout. The
         header stays an AccessText, so its mnemonic still works. -->
    <Style Selector="MenuItem.vimHint">
      <Setter Property="HeaderTemplate">
        <DataTemplate x:DataType="x:String">
          <Grid ColumnDefinitions="*,Auto">
            <AccessText Text="{Binding}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Classes="CaptionTextBlockStyle vimHintKeys"
                       Margin="24,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding $parent[MenuItem].(views:VimHint.Keys)}"
                       IsVisible="{Binding $parent[MenuItem].(views:VimHint.IsShown)}" />
          </Grid>
        </DataTemplate>
      </Setter>
    </Style>
    <!-- Styles rather than attributes in the template, which would outrank the disabled colour. -->
    <Style Selector="TextBlock.vimHintKeys">
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}" />
    </Style>
    <Style Selector="MenuItem.vimHint:disabled TextBlock.vimHintKeys">
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled}" />
    </Style>
  </Application.Styles>

  <!-- The Enigma theme is a ResourceDictionary, so it is merged as a ResourceInclude into
       Application.Resources; a StyleInclude here fails the build with AVLN2000.
       RequestedThemeVariant is deliberately unset: App assigns it from the persisted Theme setting
       before the window is shown, and IThemeService assigns it whenever the setting changes. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Enigma.Avalonia.Desktop/Themes/Fluent.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The minimap's window over the visible text: Enigma.GitClient's diff minimap colours, a wash
           and an outline of the foreground over whatever the strip is painted in. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MinimapViewportBrush" Color="#2AFFFFFF" />
          <SolidColorBrush x:Key="MinimapViewportBorderBrush" Color="#55FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MinimapViewportBrush" Color="#22000000" />
          <SolidColorBrush x:Key="MinimapViewportBorderBrush" Color="#55000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- The minimap that takes the editor's vertical scrollbar's place. Thirty-six pixels, as in
           Enigma.GitClient: a trackpad aims with a thumb rather than a cursor, and a scrollbar-thin
           strip is a hairline to it. The caret is marked in the accent colour. -->
      <ControlTheme x:Key="{x:Type views:EditorMinimap}" TargetType="views:EditorMinimap">
        <Setter Property="Width" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TrackBrush" Value="{DynamicResource EnigmaSurfaceBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource EnigmaAccentBrush}" />
        <Setter Property="ViewportBrush" Value="{DynamicResource MinimapViewportBrush}" />
        <Setter Property="ViewportBorderBrush" Value="{DynamicResource MinimapViewportBorderBrush}" />
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

</Application>
