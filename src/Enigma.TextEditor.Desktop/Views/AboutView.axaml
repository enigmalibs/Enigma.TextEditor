<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.TextEditor.Desktop.ViewModels"
             x:Class="Enigma.TextEditor.Desktop.Views.AboutView"
             x:DataType="vm:AboutViewModel"
             Width="360">

  <UserControl.Styles>
    <Style Selector="TextBlock.productName">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.quiet">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="4">
    <Image x:Name="AppIcon"
           Source="/Assets/app-256.png"
           Width="96"
           Height="96"
           Margin="0,0,0,8"
           HorizontalAlignment="Center"
           AutomationProperties.Name="Enigma Text Editor icon" />
    <TextBlock x:Name="ProductName" Classes="productName" Text="{Binding DisplayName}" />
    <TextBlock x:Name="VersionLine" Classes="quiet" Text="{Binding Version, StringFormat='Version {0}'}" />
    <!-- Absent, not blank, when the build recorded no revision. -->
    <SelectableTextBlock x:Name="BuildLine"
                         Classes="small"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource EnigmaForegroundTertiaryBrush}"
                         IsVisible="{Binding HasBuild}"
                         Text="{Binding BuildSha, StringFormat='Build {0}'}" />
    <TextBlock x:Name="CopyrightLine" Classes="quiet small" Margin="0,8,0,0" Text="{Binding Copyright}" />
  </StackPanel>
</UserControl>
