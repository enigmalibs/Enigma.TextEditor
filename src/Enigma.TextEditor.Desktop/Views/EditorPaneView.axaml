<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.TextEditor.Desktop.ViewModels"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:views="using:Enigma.TextEditor.Desktop.Views"
             x:Class="Enigma.TextEditor.Desktop.Views.EditorPaneView"
             x:DataType="vm:EditorPaneViewModel">

  <UserControl.Styles>
    <!-- One tab. A ListBoxItem rather than a Button, so the strip keeps selection and the theme's own
         hover and focus states. -->
    <Style Selector="ListBox#Tabs ListBoxItem">
      <Setter Property="Padding" Value="10,0,6,0" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox#Tabs ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EnigmaBackgroundBrush}" />
    </Style>
    <Style Selector="TextBlock.tabTitle">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="200" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox#Tabs ListBoxItem:selected TextBlock.tabTitle">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>
    <!-- The dirty dot and the close button share one fixed slot, so a tab keeps its width whichever is
         in it. -->
    <Style Selector="Panel.tabSlot">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.tabClose">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The dot shows instead of the close button on a modified tab the pointer is not over. Decided
         by styles reading a class, not by an IsVisible binding: a local value would outrank every
         style setter, :pointerover included. -->
    <Style Selector="ListBox#Tabs ListBoxItem:not(:pointerover) StackPanel.dirty Ellipse.dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBox#Tabs ListBoxItem:not(:pointerover) StackPanel.dirty Button.tabClose">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The strip's scrollbar, pinned to a thin band so it does not grow under the pointer. -->
    <Style Selector="ListBox#Tabs ScrollBar:horizontal">
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Height" Value="6" />
    </Style>
    <Style Selector="ListBox#Tabs ScrollBar:horizontal /template/ Thumb">
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Height" Value="6" />
    </Style>
    <Style Selector="ListBox#Tabs ScrollBar:horizontal /template/ RepeatButton#PART_LineUpButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox#Tabs ScrollBar:horizontal /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.paneFrame">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.paneFrame.framed">
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaAccentBrush}" />
    </Style>
    <!-- Where a dragged tab would land: a faint accent wash under a ring twice the frame's width, so it reads apart
         from the frame that marks the pane with the keyboard. -->
    <Style Selector="Panel.dropFill">
      <Setter Property="Background" Value="{DynamicResource EnigmaAccentBrush}" />
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="Border.dropRing">
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.placeholder">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundTertiaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="16" />
    </Style>
    <!-- The editor's scrollbars stand beside the text rather than over it. Left to auto-hide, the
         theme lays the text under both bars and widens them under the pointer, over the last
         characters of every line and over the bottom line. -->
    <Style Selector="edit|TextEditor#Editor /template/ ScrollViewer#PART_ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
  </UserControl.Styles>

  <!-- The frame marks the active pane once there is more than one to tell apart. -->
  <Border Classes="paneFrame" Classes.framed="{Binding IsFramed}">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource EnigmaBackgroundBrush}">

    <!-- The tab strip. Scrolls sideways rather than wrapping, so opening one more file never moves the
         editor down. -->
    <Border x:Name="Strip"
            Grid.Row="0"
            MinHeight="37"
            IsVisible="{Binding HasActiveTab}"
            Background="{DynamicResource EnigmaSurfaceBrush}"
            BorderBrush="{DynamicResource EnigmaBorderSubtleBrush}"
            BorderThickness="0,0,0,1">
      <ListBox x:Name="Tabs"
               ItemsSource="{Binding Tabs}"
               SelectedItem="{Binding ActiveTab}"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               VerticalAlignment="Top"
               Focusable="False"
               PointerReleased="OnTabsPointerReleased"
               ScrollViewer.AllowAutoHide="False"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EditorTabViewModel">
            <StackPanel Orientation="Horizontal"
                        Classes.dirty="{Binding Document.IsDirty}"
                        ToolTip.Tip="{Binding Document.ToolTip}">
              <TextBlock Classes="tabTitle" Text="{Binding Document.Title}" />
              <Panel Classes="tabSlot">
                <Ellipse Classes="dot" />
                <Button Classes="tabClose"
                        Command="{Binding #Tabs.((vm:EditorPaneViewModel)DataContext).CloseTabCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Close"
                        AutomationProperties.Name="Close tab">
                  <ei:Icon Kind="X" Size="10" />
                </Button>
              </Panel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <TextBlock Grid.Row="1"
               Classes="placeholder"
               IsVisible="{Binding !HasActiveTab}"
               Text="No file is open. Use File → Open… or File → New." />

    <!-- One editor for every tab: switching tabs swaps the document and restores where the tab was
         left, which costs a few numbers per tab instead of a whole text view. Hidden with no tab: a
         text area with no document throws the moment the pointer reaches it. -->
    <!-- The hex view of a file, read-only, in the editor's place. Its DataContext is the tab. -->
    <!-- The panel carries the pane's bindings (visibility, and the editor's font and size, which the
         rows inherit); the view inside binds to the tab. -->
    <Panel Grid.Row="1"
           IsVisible="{Binding IsHexActive}"
           TextElement.FontFamily="{Binding Preferences.FontFamily}"
           TextElement.FontSize="{Binding Preferences.FontSize}">
      <views:HexView x:Name="Hex" DataContext="{Binding ActiveTab}" />
    </Panel>

    <!-- The text and its minimap, which stands in for the vertical scrollbar: the editor's own is
         hidden (it still scrolls with the wheel), and the map beside it shows where the view and the
         caret are and scrolls to where it is pressed. Not over a hex tab, which scrolls its own rows.
         Settings → Minimap off brings the scrollbar back instead. The editor's right padding is a gap
         between the text, which the text area clips to itself, and whichever of the two stands beside
         it: a line scrolled to its end then stops short of the strip rather than against it. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
    <edit:TextEditor x:Name="Editor"
                     Grid.Column="0"
                     IsVisible="{Binding IsTextActive}"
                     Document="{Binding ActiveTab.Document.Document, FallbackValue={x:Null}}"
                     ShowLineNumbers="True"
                     WordWrap="{Binding Preferences.WordWrap}"
                     FontFamily="{Binding Preferences.FontFamily}"
                     FontSize="{Binding Preferences.FontSize}"
                     Background="Transparent"
                     Padding="0,0,6,0"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="{Binding Preferences.ShowMinimap, Converter={x:Static views:EditorPaneView.VerticalScrollBarFor}}">
      <!-- The Edit menu's commands, on this pane's text whichever pane has the keyboard. The gestures
           are shown, not bound: they are the editor's own keys. -->
      <edit:TextEditor.ContextMenu>
        <ContextMenu x:Name="EditorMenu" Opening="OnEditorMenuOpening">
          <MenuItem x:Name="MenuUndo" Header="_Undo" InputGesture="Ctrl+Z" views:VimHint.Keys="u" Click="OnMenuUndoClick" />
          <MenuItem x:Name="MenuRedo" Header="_Redo" InputGesture="Ctrl+Y" views:VimHint.Keys="Ctrl+R" Click="OnMenuRedoClick" />
          <Separator />
          <MenuItem x:Name="MenuCut" Header="Cu_t" InputGesture="Ctrl+X" Click="OnMenuCutClick" />
          <MenuItem x:Name="MenuCopy" Header="_Copy" InputGesture="Ctrl+C" Click="OnMenuCopyClick" />
          <MenuItem x:Name="MenuPaste" Header="_Paste" InputGesture="Ctrl+V" Click="OnMenuPasteClick" />
          <MenuItem x:Name="MenuDelete" Header="_Delete" InputGesture="Delete" views:VimHint.Keys="x" Click="OnMenuDeleteClick" />
          <Separator />
          <MenuItem x:Name="MenuSelectAll" Header="Select _All" InputGesture="Ctrl+A" views:VimHint.Keys="ggVG" Click="OnMenuSelectAllClick" />
        </ContextMenu>
      </edit:TextEditor.ContextMenu>
    </edit:TextEditor>
    <views:EditorMinimap x:Name="Minimap"
                         Grid.Column="1"
                         AutomationProperties.Name="Where the view and the caret are in this file">
      <views:EditorMinimap.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsTextActive" />
          <Binding Path="Preferences.ShowMinimap" />
        </MultiBinding>
      </views:EditorMinimap.IsVisible>
    </views:EditorMinimap>
    </Grid>

    <!-- Over the whole pane, last so it is drawn on top, and never in the pointer's way. Shown by the pane a tab is
         dragged from, on the pane the tab would land on: over all four quarters of this grid when the tab would move
         here, over the half on one side when the pane would split there for it, where the new pane will stand. -->
    <Grid Grid.Row="0"
          Grid.RowSpan="2"
          ColumnDefinitions="*,*"
          RowDefinitions="*,*"
          IsHitTestVisible="False">
      <Panel x:Name="DropHint"
             Grid.ColumnSpan="2"
             Grid.RowSpan="2"
             IsVisible="False"
             IsHitTestVisible="False">
        <Panel Classes="dropFill" IsHitTestVisible="False" />
        <Border Classes="dropRing" IsHitTestVisible="False" />
      </Panel>
    </Grid>
  </Grid>
  </Border>
</UserControl>
