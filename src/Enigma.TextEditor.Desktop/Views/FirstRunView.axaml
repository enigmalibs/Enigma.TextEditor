<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.TextEditor.Desktop.ViewModels"
             xmlns:views="using:Enigma.TextEditor.Desktop.Views"
             xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
             xmlns:settings="using:Enigma.TextEditor.Core.Settings"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             x:Class="Enigma.TextEditor.Desktop.Views.FirstRunView"
             x:DataType="vm:FirstRunViewModel"
             Width="520">

  <UserControl.Resources>
    <!-- The settings page's words for the same choices. -->
    <DataTemplate x:Key="ThemeItem" x:DataType="settings:AppTheme">
      <TextBlock Text="{Binding Converter={x:Static views:SettingsPageView.ThemeText}}" />
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.intro">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Enigma.MarkdownEditor's welcome rows: the first screen of the application looks like the rest of
       it, and every one of these is on the settings page as well. -->
  <StackPanel Spacing="12">

    <TextBlock x:Name="Intro"
               Classes="intro"
               Text="Four things worth choosing before you start. Every one of them — and the font, the indentation and the line endings — can be changed later on the settings page, the gear at the bottom of the rail." />

    <controls:SettingsCard x:Name="ThemeRow"
                           Header="Theme"
                           Description="Follow the system keeps following your desktop's light or dark setting."
                           IconData="{ei:IconGeometry Palette}">
      <ComboBox x:Name="ThemeChoice"
                MinWidth="160"
                ItemsSource="{Binding Themes}"
                SelectedItem="{Binding Theme, Mode=TwoWay}"
                ItemTemplate="{StaticResource ThemeItem}"
                AutomationProperties.Name="Theme" />
    </controls:SettingsCard>

    <controls:SettingsCard x:Name="VimRow"
                           Header="Vim mode"
                           Description="Normal, insert and visual modes, the ex commands and the Vim keys. Off, the editor types as any other."
                           IconData="{ei:IconGeometry Keyboard}">
      <ToggleSwitch x:Name="VimSwitch"
                    IsChecked="{Binding VimEnabled, Mode=TwoWay}"
                    AutomationProperties.Name="Vim mode" />
    </controls:SettingsCard>

    <controls:SettingsCard x:Name="MinimapRow"
                           Header="Minimap"
                           Description="A strip beside the text that shows where you are, and scrolls to where it is pressed. Off, a plain scrollbar."
                           IconData="{ei:IconGeometry MapTrifold}">
      <ToggleSwitch x:Name="MinimapSwitch"
                    IsChecked="{Binding ShowMinimap, Mode=TwoWay}"
                    AutomationProperties.Name="Minimap" />
    </controls:SettingsCard>

    <controls:SettingsCard x:Name="WordWrapRow"
                           Header="Wrap long lines"
                           Description="At the edge of the editor, rather than scrolling sideways."
                           IconData="{ei:IconGeometry TextAlignLeft}">
      <ToggleSwitch x:Name="WordWrapSwitch"
                    IsChecked="{Binding WordWrap, Mode=TwoWay}"
                    AutomationProperties.Name="Wrap long lines" />
    </controls:SettingsCard>

  </StackPanel>
</UserControl>
