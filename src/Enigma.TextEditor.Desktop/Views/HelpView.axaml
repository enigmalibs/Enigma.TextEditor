<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.TextEditor.Desktop.ViewModels"
             xmlns:views="using:Enigma.TextEditor.Desktop.Views"
             xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
             x:Class="Enigma.TextEditor.Desktop.Views.HelpView"
             x:DataType="vm:HelpViewModel"
             Width="760">

  <!-- A card per section, a line per command: the keys, what they do, and the ex command that does it too. -->
  <UserControl.Styles>
    <Style Selector="Grid.helpRow">
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="TextBlock.helpKeys">
      <Setter Property="FontFamily" Value="{x:Static vm:EditorPreferences.MonospaceFamily}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="TextBlock.helpEx">
      <Setter Property="FontFamily" Value="{x:Static vm:EditorPreferences.MonospaceFamily}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- The one scroll area of the help: the dialog card around it is kept from scrolling (see the code-behind),
       its bar is always shown at full size, and it takes the keyboard (j/k, Ctrl+D/U, g/G, q). -->
  <ScrollViewer x:Name="Scroller"
                Focusable="True"
                AllowAutoHide="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Visible"
                MaxHeight="440">
    <ItemsControl x:Name="Cards" ItemsSource="{Binding Sections}" Margin="0,0,16,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:HelpSection">
          <controls:SettingsCardExpander Header="{Binding Category}"
                                         Description="{Binding Description}"
                                         IconData="{Binding Icon, Converter={x:Static views:IconGeometryConverter.Instance}}"
                                         IsExpanded="True"
                                         Focusable="False">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HelpRow">
                  <Grid ColumnDefinitions="190,*,200" Classes="helpRow">
                    <TextBlock Classes="helpKeys" Text="{Binding Keys}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Classes="helpEx" Text="{Binding ExCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </controls:SettingsCardExpander>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
