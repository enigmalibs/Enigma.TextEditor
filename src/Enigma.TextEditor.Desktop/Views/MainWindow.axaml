<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Enigma.TextEditor.Desktop.ViewModels"
        xmlns:views="using:Enigma.TextEditor.Desktop.Views"
        xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
        xmlns:contentDialog="using:Enigma.Avalonia.Desktop.Controls.ContentDialog"
        xmlns:infoBar="using:Enigma.Avalonia.Desktop.Controls.InfoBar"
        xmlns:nav="using:Enigma.Avalonia.Desktop.Controls.Navigation"
        x:Class="Enigma.TextEditor.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="1200" Height="800"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource EnigmaBackgroundBrush}"
        views:VimHint.IsShown="{Binding Settings.IsVimEnabled}">

  <Window.Resources>
    <!-- The rail's items, smaller than Enigma.GitClient's: the icon alone, no label under it. The name
         the label would have shown is the tooltip and what a screen reader says. Keyed by type here, so
         it replaces the library's theme for this window's rail only. -->
    <ControlTheme x:Key="{x:Type nav:NavigationItem}" TargetType="nav:NavigationItem">
      <Setter Property="Margin" Value="1" />
      <Setter Property="ToolTip.Tip" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <PathIcon Data="{TemplateBinding IconData}"
                    Width="20"
                    Height="20"
                    Margin="{TemplateBinding Margin}"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource EnigmaForegroundBrush}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <!-- The status bar: one quiet strip under the content, with a hairline between the two. -->
    <Style Selector="Border.statusBar">
      <Setter Property="Background" Value="{DynamicResource EnigmaSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Border.statusBar TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The Vim mode chip: quiet for normal, green for insert, amber for either visual mode — the
         palette's success and warning pairs, with the primary foreground on them (WCAG AA on every
         severity fill, per Enigma.Avalonia.Desktop). -->
    <Style Selector="Border.vimMode">
      <Setter Property="Background" Value="{DynamicResource EnigmaHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="0,3,10,3" />
      <Setter Property="MinWidth" Value="64" />
    </Style>
    <Style Selector="Border.vimMode > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
    <Style Selector="Border.vimMode.insert">
      <Setter Property="Background" Value="{DynamicResource EnigmaSuccessBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaSuccessBorderBrush}" />
    </Style>
    <Style Selector="Border.vimMode.visual">
      <Setter Property="Background" Value="{DynamicResource EnigmaWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaWarningBorderBrush}" />
    </Style>
    <Style Selector="Border.vimMode.insert > TextBlock, Border.vimMode.visual > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>
    <!-- The ex/search line: monospaced and in the ordinary foreground, because it is being typed
         rather than reported. -->
    <Style Selector="TextBlock.commandLine">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, Menlo, monospace" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>
    <!-- A status item that is also a way in to the tool that changes it: flat, the bar's own size.
         Stretched to the bar and its text centred in it, so the text is centred in the very span the
         plain status texts are, and sits on their line: a stretched content draws its text at the top. -->
    <Style Selector="Button.statusItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.statusItem">
      <Setter Property="Margin" Value="14,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
    <!-- The menu bar: separated from the content by the same hairline as the status bar. -->
    <Style Selector="Border.menuBar">
      <Setter Property="Background" Value="{DynamicResource EnigmaSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <!-- The splitter between two panes: a hairline that still has a few pixels to grab. -->
    <Style Selector="GridSplitter.paneSplitter">
      <Setter Property="Background" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
      <Setter Property="MinWidth" Value="3" />
      <Setter Property="MinHeight" Value="3" />
    </Style>
  </Window.Styles>

  <!-- The file commands' shortcuts. The editing ones (Ctrl+Z, Ctrl+C…) are the editor's own and are
       only shown in the menu, never bound here, so they keep working inside the text. Ctrl+W stays
       free for Vim's window commands, which is why Close Tab is Ctrl+F4. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding Workspace.NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding Workspace.OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding Workspace.SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding Workspace.SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+F4" Command="{Binding Workspace.CloseTabCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding Workspace.NextTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding Workspace.PreviousTabCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding Settings.ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding Settings.ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding Settings.ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding Settings.ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding Settings.ResetZoomCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding HelpCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding Shell.ShowSettingsCommand}" />
  </Window.KeyBindings>

  <Panel>
    <!-- Top to bottom: the menu bar, the content and the status bar. The title bar is the
         platform's own, so the window looks like every other application on the desktop. -->
    <DockPanel x:Name="Shell">
      <Border DockPanel.Dock="Top" Classes="menuBar">
        <Menu x:Name="MainMenu">
          <MenuItem Header="_File">
            <MenuItem Header="_New" Command="{Binding Workspace.NewCommand}" InputGesture="Ctrl+N" views:VimHint.Keys=":enew" />
            <MenuItem Header="_Open…" Command="{Binding Workspace.OpenCommand}" InputGesture="Ctrl+O" views:VimHint.Keys=":e" />
            <MenuItem Header="Open as _Hex…" Command="{Binding Workspace.OpenHexCommand}" />
            <Separator />
            <MenuItem Header="_Save" Command="{Binding Workspace.SaveCommand}" InputGesture="Ctrl+S" views:VimHint.Keys=":w" />
            <MenuItem Header="Save _As…" Command="{Binding Workspace.SaveAsCommand}" InputGesture="Ctrl+Shift+S" views:VimHint.Keys=":w {file}" />
            <MenuItem Header="Save A_ll" Command="{Binding Workspace.SaveAllCommand}" views:VimHint.Keys=":wa" />
            <Separator />
            <MenuItem Header="_Close Tab" Command="{Binding Workspace.CloseTabCommand}" InputGesture="Ctrl+F4" views:VimHint.Keys=":q" />
            <Separator />
            <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="Alt+F4" views:VimHint.Keys=":qa" />
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem x:Name="UndoItem" Header="_Undo" Click="OnUndoClick" InputGesture="Ctrl+Z" views:VimHint.Keys="u" />
            <MenuItem x:Name="RedoItem" Header="_Redo" Click="OnRedoClick" InputGesture="Ctrl+Y" views:VimHint.Keys="Ctrl+R" />
            <Separator />
            <MenuItem Header="Cu_t" Click="OnCutClick" InputGesture="Ctrl+X" />
            <MenuItem Header="_Copy" Click="OnCopyClick" InputGesture="Ctrl+C" />
            <MenuItem Header="_Paste" Click="OnPasteClick" InputGesture="Ctrl+V" />
            <Separator />
            <MenuItem Header="Select _All" Click="OnSelectAllClick" InputGesture="Ctrl+A" views:VimHint.Keys="ggVG" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="Split _Right" Command="{Binding Workspace.SplitRightCommand}" views:VimHint.Keys="Ctrl+W v" />
            <MenuItem Header="Split _Down" Command="{Binding Workspace.SplitDownCommand}" views:VimHint.Keys="Ctrl+W s" />
            <MenuItem Header="_Close Pane" Command="{Binding Workspace.ClosePaneCommand}" views:VimHint.Keys="Ctrl+W c" />
            <MenuItem Header="_Only This Pane" Command="{Binding Workspace.OnlyPaneCommand}" views:VimHint.Keys="Ctrl+W o" />
            <MenuItem Header="_Equalize Panes" Command="{Binding Workspace.EqualizeCommand}" views:VimHint.Keys="Ctrl+W =" />
            <Separator />
            <MenuItem Header="Focus _Next Pane" Command="{Binding Workspace.FocusNextPaneCommand}" views:VimHint.Keys="Ctrl+W w" />
            <MenuItem Header="Focus _Previous Pane" Command="{Binding Workspace.FocusPreviousPaneCommand}" views:VimHint.Keys="Ctrl+W W" />
            <Separator />
            <MenuItem Header="Zoom _In" Command="{Binding Settings.ZoomInCommand}" InputGesture="Ctrl+OemPlus" />
            <MenuItem Header="Zoom O_ut" Command="{Binding Settings.ZoomOutCommand}" InputGesture="Ctrl+OemMinus" />
            <MenuItem Header="Reset _Zoom" Command="{Binding Settings.ResetZoomCommand}" InputGesture="Ctrl+D0" />
          </MenuItem>
          <MenuItem Header="_Tools">
            <MenuItem Header="Set _Language…" Command="{Binding Tools.SetLanguageCommand}" />
            <Separator />
            <MenuItem Header="_Reopen with Encoding…" Command="{Binding Tools.ReopenWithEncodingCommand}" />
            <MenuItem Header="Change File _Encoding…" Command="{Binding Tools.ChangeEncodingCommand}" />
            <MenuItem Header="Reopen as _Hex" Command="{Binding Tools.ReopenAsHexCommand}" />
            <MenuItem Header="Reopen as _Text" Command="{Binding Tools.ReopenAsTextCommand}" />
            <Separator />
            <MenuItem Header="Line E_ndings">
              <MenuItem Header="LF" ToggleType="Radio" GroupName="lineEndings"
                        IsChecked="{Binding Tools.IsLf, Mode=OneWay}" Command="{Binding Tools.UseLfCommand}" />
              <MenuItem Header="CRLF" ToggleType="Radio" GroupName="lineEndings"
                        IsChecked="{Binding Tools.IsCrLf, Mode=OneWay}" Command="{Binding Tools.UseCrLfCommand}" />
            </MenuItem>
            <MenuItem Header="_Indentation">
              <MenuItem Header="Spaces: 2" ToggleType="Radio" GroupName="indentation"
                        IsChecked="{Binding Tools.IsTwoSpaces, Mode=OneWay}" Command="{Binding Tools.IndentWithTwoSpacesCommand}" />
              <MenuItem Header="Spaces: 4" ToggleType="Radio" GroupName="indentation"
                        IsChecked="{Binding Tools.IsFourSpaces, Mode=OneWay}" Command="{Binding Tools.IndentWithFourSpacesCommand}" />
              <MenuItem Header="Tabs" ToggleType="Radio" GroupName="indentation"
                        IsChecked="{Binding Tools.IsTabs, Mode=OneWay}" Command="{Binding Tools.IndentWithTabsCommand}" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="_Settings">
            <MenuItem Header="_Theme">
              <MenuItem Header="_System" ToggleType="Radio" GroupName="theme"
                        IsChecked="{Binding Settings.IsSystemTheme, Mode=OneWay}" Command="{Binding Settings.UseSystemThemeCommand}" />
              <MenuItem Header="_Light" ToggleType="Radio" GroupName="theme"
                        IsChecked="{Binding Settings.IsLightTheme, Mode=OneWay}" Command="{Binding Settings.UseLightThemeCommand}" />
              <MenuItem Header="_Dark" ToggleType="Radio" GroupName="theme"
                        IsChecked="{Binding Settings.IsDarkTheme, Mode=OneWay}" Command="{Binding Settings.UseDarkThemeCommand}" />
            </MenuItem>
            <MenuItem Header="_Vim Mode" ToggleType="CheckBox"
                      IsChecked="{Binding Settings.IsVimEnabled, Mode=OneWay}" Command="{Binding Settings.ToggleVimCommand}" />
            <MenuItem Header="_Word Wrap" ToggleType="CheckBox"
                      IsChecked="{Binding Settings.IsWordWrap, Mode=OneWay}" Command="{Binding Settings.ToggleWordWrapCommand}" />
            <MenuItem Header="_Minimap" ToggleType="CheckBox"
                      IsChecked="{Binding Settings.IsMinimap, Mode=OneWay}" Command="{Binding Settings.ToggleMinimapCommand}" />
            <MenuItem Header="Pane _Resize Step">
              <MenuItem Header="2%" ToggleType="Radio" GroupName="paneResizeStep"
                        IsChecked="{Binding Settings.IsResizeStep2, Mode=OneWay}" Command="{Binding Settings.ResizeStep2Command}" />
              <MenuItem Header="5%" ToggleType="Radio" GroupName="paneResizeStep"
                        IsChecked="{Binding Settings.IsResizeStep5, Mode=OneWay}" Command="{Binding Settings.ResizeStep5Command}" />
              <MenuItem Header="10%" ToggleType="Radio" GroupName="paneResizeStep"
                        IsChecked="{Binding Settings.IsResizeStep10, Mode=OneWay}" Command="{Binding Settings.ResizeStep10Command}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Default _Indentation">
              <MenuItem Header="Spaces: 2" ToggleType="Radio" GroupName="defaultIndentation"
                        IsChecked="{Binding Settings.IsDefaultTwoSpaces, Mode=OneWay}" Command="{Binding Settings.DefaultTwoSpacesCommand}" />
              <MenuItem Header="Spaces: 4" ToggleType="Radio" GroupName="defaultIndentation"
                        IsChecked="{Binding Settings.IsDefaultFourSpaces, Mode=OneWay}" Command="{Binding Settings.DefaultFourSpacesCommand}" />
              <MenuItem Header="Tabs" ToggleType="Radio" GroupName="defaultIndentation"
                        IsChecked="{Binding Settings.IsDefaultTabs, Mode=OneWay}" Command="{Binding Settings.DefaultTabsCommand}" />
            </MenuItem>
            <MenuItem Header="Default _Line Endings">
              <MenuItem Header="LF" ToggleType="Radio" GroupName="defaultLineEndings"
                        IsChecked="{Binding Settings.IsDefaultLf, Mode=OneWay}" Command="{Binding Settings.DefaultLfCommand}" />
              <MenuItem Header="CRLF" ToggleType="Radio" GroupName="defaultLineEndings"
                        IsChecked="{Binding Settings.IsDefaultCrLf, Mode=OneWay}" Command="{Binding Settings.DefaultCrLfCommand}" />
            </MenuItem>
            <Separator />
            <!-- The settings page: every setting above, and the full range of each, grouped by what it
                 acts on. No ellipsis: it shows a page, it opens no dialog. -->
            <MenuItem Header="_All Settings" Command="{Binding Shell.ShowSettingsCommand}" InputGesture="Ctrl+OemComma" />
          </MenuItem>
          <MenuItem Header="_Help">
            <MenuItem Header="_Key Bindings" Command="{Binding HelpCommand}" InputGesture="F1" views:VimHint.Keys=":help" />
            <Separator />
            <MenuItem Header="_About Enigma Text Editor" Command="{Binding AboutCommand}" />
          </MenuItem>
        </Menu>
      </Border>

      <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Classes="statusBar">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border x:Name="ModeChip"
                  Grid.Column="0"
                  Classes="vimMode"
                  Classes.insert="{Binding StatusBar.IsInsertMode}"
                  Classes.visual="{Binding StatusBar.IsVisualMode}"
                  IsVisible="{Binding StatusBar.IsModeChipVisible}">
            <TextBlock x:Name="ModeText" Text="{Binding StatusBar.ModeText}" />
          </Border>
          <!-- One slot, two things that take it in turns: the message line, and the command line
               while ':' or '/' is being typed. -->
          <Panel Grid.Column="1">
            <TextBlock x:Name="MessageLine"
                       IsVisible="{Binding !StatusBar.IsCommandLineVisible}"
                       Text="{Binding StatusBar.Messages.Current}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CommandLine"
                       Classes="commandLine"
                       IsVisible="{Binding StatusBar.IsCommandLineVisible}"
                       Text="{Binding StatusBar.CommandLine}" />
          </Panel>
          <!-- The buttons take no focus, so a click leaves the keyboard in the pane; a flyout, which does
               take it, gives it back to the pane as it closes. -->
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      IsVisible="{Binding StatusBar.HasActiveTab}">
            <TextBlock x:Name="CaretStatus" Classes="statusItem" Text="{Binding StatusBar.CaretText}" />
            <TextBlock x:Name="SizeStatus"
                       Classes="statusItem"
                       IsVisible="{Binding StatusBar.IsHexTab}"
                       Text="{Binding StatusBar.SizeText}" />
            <Button x:Name="IndentationStatus"
                    Focusable="False"
                    IsVisible="{Binding StatusBar.IsTextTab}"
                    Classes="statusItem"
                    Content="{Binding StatusBar.IndentationText}"
                    ToolTip.Tip="Indentation"
                    AutomationProperties.Name="Indentation">
              <Button.Flyout>
                <MenuFlyout Closed="OnStatusFlyoutClosed">
                  <MenuItem Header="Spaces: 2" ToggleType="Radio" GroupName="statusIndentation"
                            IsChecked="{Binding Tools.IsTwoSpaces, Mode=OneWay}" Command="{Binding Tools.IndentWithTwoSpacesCommand}" />
                  <MenuItem Header="Spaces: 4" ToggleType="Radio" GroupName="statusIndentation"
                            IsChecked="{Binding Tools.IsFourSpaces, Mode=OneWay}" Command="{Binding Tools.IndentWithFourSpacesCommand}" />
                  <MenuItem Header="Tabs" ToggleType="Radio" GroupName="statusIndentation"
                            IsChecked="{Binding Tools.IsTabs, Mode=OneWay}" Command="{Binding Tools.IndentWithTabsCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="EncodingStatus"
                    Focusable="False"
                    IsVisible="{Binding StatusBar.IsTextTab}"
                    Classes="statusItem"
                    Content="{Binding StatusBar.EncodingText}"
                    ToolTip.Tip="Encoding"
                    AutomationProperties.Name="Encoding">
              <Button.Flyout>
                <MenuFlyout Closed="OnStatusFlyoutClosed">
                  <MenuItem Header="Reopen with Encoding…" Command="{Binding Tools.ReopenWithEncodingCommand}" />
                  <MenuItem Header="Change File Encoding…" Command="{Binding Tools.ChangeEncodingCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="LanguageStatus"
                    Focusable="False"
                    IsVisible="{Binding StatusBar.IsTextTab}"
                    Classes="statusItem"
                    Content="{Binding StatusBar.LanguageText}"
                    Command="{Binding Tools.SetLanguageCommand}"
                    ToolTip.Tip="Set language"
                    AutomationProperties.Name="Set language" />
            <Button x:Name="LineEndingStatus"
                    Focusable="False"
                    IsVisible="{Binding StatusBar.IsTextTab}"
                    Classes="statusItem"
                    Content="{Binding StatusBar.LineEndingText}"
                    ToolTip.Tip="Line endings"
                    AutomationProperties.Name="Line endings">
              <Button.Flyout>
                <MenuFlyout Closed="OnStatusFlyoutClosed">
                  <MenuItem Header="LF" ToggleType="Radio" GroupName="statusLineEndings"
                            IsChecked="{Binding Tools.IsLf, Mode=OneWay}" Command="{Binding Tools.UseLfCommand}" />
                  <MenuItem Header="CRLF" ToggleType="Radio" GroupName="statusLineEndings"
                            IsChecked="{Binding Tools.IsCrLf, Mode=OneWay}" Command="{Binding Tools.UseCrLfCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <!-- Last, and on any tab: the other items describe the file, this one the size every editor and the hex
                 view draw text at. Each size in the list carries the command that sets it. -->
            <Button x:Name="FontSizeStatus"
                    Focusable="False"
                    Classes="statusItem"
                    Content="{Binding Settings.FontSizeText}"
                    ToolTip.Tip="Font size"
                    AutomationProperties.Name="Font size">
              <Button.Flyout>
                <MenuFlyout Closed="OnStatusFlyoutClosed" ItemsSource="{Binding Settings.FontSizeChoices}">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem"
                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                  x:DataType="vm:FontSizeChoice">
                      <Setter Property="Header" Value="{Binding Header}" />
                      <Setter Property="ToggleType" Value="Radio" />
                      <Setter Property="GroupName" Value="statusFontSize" />
                      <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                      <Setter Property="Command" Value="{Binding Command}" />
                      <Setter Property="CommandParameter" Value="{Binding Size}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- The rail: the files at the top, the settings at the bottom. Between the menu bar and the status
           bar, as Enigma.GitClient's sits under its repository strip, and much narrower: icons only. -->
      <nav:NavigationView x:Name="Rail"
                          DockPanel.Dock="Left"
                          Items="{Binding Shell.Items}"
                          FooterItems="{Binding Shell.FooterItems}"
                          SelectedItem="{Binding Shell.SelectedItem, Mode=TwoWay}"
                          PaneSize="44" />

      <!-- One page at a time. The files page is hidden rather than taken out: its panes keep their
           documents' carets, scroll and highlighting. The settings page is put in the first time it is
           shown (see the code-behind): listing the fonts it offers measures every font installed. -->
      <Panel>
        <Panel x:Name="FilesPage" IsVisible="{Binding Shell.IsFilesPage}">
          <views:SplitHost x:Name="Splits" DataContext="{Binding Workspace}" />
        </Panel>
        <ContentControl x:Name="SettingsHost" IsVisible="{Binding Shell.IsSettingsPage}" />
      </Panel>
    </DockPanel>

    <!-- The three Enigma hosts, last so they overlay everything the editor draws. -->
    <!-- Tab cycles inside the dialog rather than leaving it for the window behind; DialogKeyboard gives
         it the keyboard as it opens and hands it back as it closes. -->
    <contentDialog:ContentDialog x:Name="HostDialog"
                                 KeyboardNavigation.TabNavigation="Cycle"
                                 DialogMinWidth="360"
                                 DialogMaxWidth="860"
                                 DialogMaxHeight="640" />
    <controls:Overlay x:Name="HostOverlay" />
    <infoBar:InfoBar x:Name="HostInfoBar" />
  </Panel>
</Window>
